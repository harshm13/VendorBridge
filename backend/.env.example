# VendorBridge Enterprise ERP Environment Configuration Template
PORT=5000
NODE_ENV=development
JWT_SECRET=vendorbridge-quantum-jwt-secret-key-2026-auth

# Database Configuration (MySQL)
# If MySQL is not running locally, the server automatically operates in high-speed Hybrid JSON Mode using database/data.json (generated from database/data.seed.json)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vendorbridge

# Frontend & CORS Configuration
# In production, set to your specific origin(s) separated by commas, e.g.:
# FRONTEND_URL=https://vendorbridge.global,https://app.vendorbridge.global
FRONTEND_URL=http://localhost:5000,http://localhost:3000
CORS_ORIGIN=http://localhost:5000,http://localhost:3000

# Optional External AI API Key (OpenAI or Google Gemini)
# Leave blank to use the built-in Procurement Heuristic Engine
OPENAI_API_KEY=
GEMINI_API_KEY=
